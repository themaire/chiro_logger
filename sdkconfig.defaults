# ===========================================================================
# sdkconfig.defaults — Chiro Logger ESP32-C3
# Ces paramètres s'appliquent en priorité sur le sdkconfig généré.
# ===========================================================================

# ---------------------------------------------------------------------------
# BLE — Stack NimBLE (recommandé pour ESP32-C3 / RISC-V)
# ---------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# Rôles nécessaires : périphérique + broadcaster (advertising)
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# Rôles non utilisés : désactivés pour économiser la mémoire
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# Taille de la pile NimBLE host task
CONFIG_BT_NIMBLE_STACK_SIZE=4096

# Persistance NVS pour le bonding (permet de retrouver un appareil pairé)
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Nom du device BLE (override possible dans le code)
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="ChiroLogger"

# Connexions simultanées max (1 suffit pour notre usage)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Task NimBLE sur core 0 (partagé avec le reste de l'app sur ESP32-C3 unicore)
CONFIG_BT_NIMBLE_PINNED_TO_CORE=0

# ---------------------------------------------------------------------------
# Optimisations mémoire flash et logs (déjà gérées en partie par platformio.ini)
# ---------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL=0
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0
CONFIG_LOG_MAXIMUM_LEVEL=0
